{
  "name": "local-dashboard",
  "version": "2.0.1",
  "description": "A native dashboard for local development servers and utilities.",
  "type": "module",
  "author": "Tanjim Islam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tanjim-Islam/localhost-dashboard.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "dev:clis-test": "node scripts/start-fixture.mjs",
    "build": "tauri build --no-bundle",
    "build:renderer": "vite build",
    "build:debug": "tauri build --debug --no-bundle",
    "package": "tauri build",
    "package:mac": "tauri build --target universal-apple-darwin",
    "test": "npm run test:renderer && npm run test:native",
    "test:renderer": "node scripts/test-renderer.mjs",
    "test:native": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:servers": "cargo test --locked --manifest-path src-tauri/Cargo.toml servers::",
    "test:clis": "cargo test --locked --manifest-path src-tauri/Cargo.toml clis::",
    "test:env-keys": "cargo test --locked --manifest-path src-tauri/Cargo.toml automation::environment:: -- --test-threads=1",
    "test:startup": "cargo test --locked --manifest-path src-tauri/Cargo.toml settings::",
    "test:desktop": "npm run build:debug && node scripts/desktop.integration.mjs",
    "lint": "eslint --ext .ts,.tsx src",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml && prettier -w src/renderer",
    "start:test-servers": "node scripts/dev-servers.js"
  },
  "keywords": [],
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/noto-sans-bengali": "^5.2.11",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@radix-ui/react-select": "^2.3.3",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.19",
    "eslint": "^9.39.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.21.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.4.47",
    "prettier": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
