{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/main/automator-detection.ts",
    "src/main/automator-services.ts",
    "src/main/app-identity.ts",
    "src/main/environment-variables.ts",
    "src/main/platform-features.ts",
    "src/main/server-detection.ts",
    "src/main/cleaner/**/*.ts",
    "src/renderer/cleaner-*.ts",
    "src/renderer/theme/themeRegistry.ts",
    "src/renderer/components/titleBarLayout.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["src/main/cleaner/cleaner-store.ts", "src/main/cleaner/index.ts"]
}
