{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/types/*.d.ts",
    "tests/titlebar-layout.test.ts",
    "tests/semantic-colors.test.ts",
    "tests/clis-renderer-contract.test.ts"
  ]
}
